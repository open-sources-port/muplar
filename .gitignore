# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

/build
/android-root/
/sysroots/local/
/.muplar-sysroots/
/**/.cache
/**/*.log
/**/.DS_Store
.codegraph

# Bundled JDK binaries — downloaded by tools/setup-jdk.sh, not committed to git.
# Each developer runs this once: tools/setup-jdk.sh
third_party/jdk-bin/

# Keep pre-built ANGLE dylibs tracked (overrides the *.dylib rule above)
!third_party/angle-bin/*.dylib
**/.cache